{
  "description": "Glint: reviews the English in each prompt and keeps a journal of corrections",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/glint.mjs\" prompt",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/glint.mjs\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
